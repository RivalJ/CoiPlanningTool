<UserControl x:Class="CoiPlanningTool.MachinePrefab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CoiPlanningTool"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="200">
    <Grid>
        <Border Background="LightBlue" CornerRadius="8" Padding="10"></Border>
        <!--<TextBlock x:Name="TitleText" Text="Card Title" FontWeight="Bold"/>-->
        <TextBlock x:Name="BodyText" Text="This is a dynamically added card." Margin="0,5,0,0"/>
        <StackPanel x:Name="Prefab" Margin="10"></StackPanel>
    </Grid>
</UserControl>
