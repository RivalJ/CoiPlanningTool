<Window x:Class="CoiPlanningTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoiPlanningTool"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Canvas x:Name="mainCanvas"
            MouseLeftButtonDown="leftMouseBtn"
            MouseRightButtonDown="rightMouseBtn"
            MouseRightButtonUp="rightMouseBtnUp"
            MouseLeftButtonUp="leftMouseBtnUp"
            MouseMove="mouseMove"
            Background="DarkGray">
        <Button x:Name="btnAdd" Margin="0,5,0,0" Click="ButtonAddName_Click">Add Name</Button>
    </Canvas>
</Window>
